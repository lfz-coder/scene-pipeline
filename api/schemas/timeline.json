{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "clips": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/Id"
              },
              "asset_id": {
                "$ref": "common.json#/$defs/Id"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "in_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3600000
              },
              "out_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000
              }
            },
            "required": [
              "id",
              "asset_id",
              "title",
              "in_ms",
              "out_ms"
            ]
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "version",
        "clips"
      ]
    }
  }
}
