{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Pipeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "prepare",
                  "analyze",
                  "review",
                  "assemble"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "waiting",
                  "done",
                  "failed",
                  "cancelled"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "prepare",
                    "analyze",
                    "review",
                    "assemble"
                  ]
                },
                "minItems": 0,
                "maxItems": 3
              }
            },
            "required": [
              "id",
              "status",
              "depends_on"
            ]
          },
          "minItems": 4,
          "maxItems": 4
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/Id"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 100,
                "maximum": 60000
              }
            },
            "required": [
              "id",
              "title",
              "duration_ms"
            ]
          },
          "minItems": 0,
          "maxItems": 12
        }
      },
      "required": [
        "version",
        "nodes",
        "shots"
      ]
    }
  }
}
